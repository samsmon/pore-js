{
  "name": "porejs-react",
  "version": "1.0.0-rc.3",
  "description": "React 19 bindings for porejs: headless <Reader> + hooks",
  "license": "MIT",
  "author": "Surya",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "reader",
    "epub",
    "pdf",
    "cbz",
    "manga",
    "react",
    "headless",
    "ereader",
    "porejs"
  ],
  "homepage": "https://github.com/samsmon/pore-js#readme",
  "bugs": "https://github.com/samsmon/pore-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samsmon/pore-js.git",
    "directory": "packages/reader-react"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "import": "./dist/reader.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./gsap": {
      "types": "./dist/gsap.d.ts",
      "import": "./dist/gsap.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "porejs": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-visually-hidden": "^1.2.11"
  },
  "peerDependencies": {
    "gsap": ">=3.12.0",
    "porejs": "1.0.0-rc.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "porejs": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
